:root {
  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #262522;
  background: #f4f2ed;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --bg: #f4f2ed;
  --surface: #fbfaf7;
  --surface-strong: #ffffff;
  --ink: #262522;
  --muted: #8d8a82;
  --line: #e8e5de;
  --accent: #c7663f;
  --accent-soft: #f6e5dd;
  --sidebar: #eeece6;
  --shadow: 0 12px 30px rgba(58, 48, 35, .07);
}

* { box-sizing: border-box; }
html, body, #app { min-width: 320px; min-height: 100%; }
body { margin: 0; min-height: 100vh; background: var(--bg); }
button, input { font: inherit; }
button { border: 0; cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid rgba(199, 102, 63, .28); outline-offset: 3px; }
.app-shell { display: flex; min-height: 100vh; height: 100vh; overflow: hidden; }

.sidebar { width: 176px; flex: 0 0 176px; display: flex; flex-direction: column; padding: 20px 12px 14px; background: var(--sidebar); border-right: 1px solid var(--line); }
.brand-lockup, .profile-chip, .side-status, .nav-item, .top-actions, .breadcrumb, .section-heading, .service-card, .recent-row, .hero-proof { display: flex; align-items: center; }
.brand-lockup { gap: 9px; padding: 0 8px 23px; }
.brand-mark { width: 28px; height: 28px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 8px; background: var(--accent); color: white; box-shadow: 0 5px 12px rgba(199,102,63,.2); }
.brand-lockup strong { display: block; font-size: 13px; letter-spacing: -.02em; }
.brand-lockup span, .profile-chip span { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; }
.primary-nav, .secondary-nav { display: grid; gap: 4px; }
.nav-item { width: 100%; min-height: 37px; gap: 9px; padding: 0 8px; border-radius: 9px; background: transparent; color: #77736b; text-align: left; font-size: 12px; transition: background .18s ease, color .18s ease, transform .18s ease; }
.nav-item:hover { background: rgba(255,255,255,.62); color: var(--ink); transform: translateX(1px); }
.nav-item.active { background: var(--surface-strong); color: var(--ink); box-shadow: 0 5px 14px rgba(61, 52, 43, .06); }
.nav-icon { width: 25px; height: 25px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid transparent; border-radius: 7px; color: #98938a; background: rgba(255,255,255,.28); transition: background .18s ease, color .18s ease, border-color .18s ease; }
.nav-icon svg { width: 15px; height: 15px; stroke-width: 1.8; }
.nav-item:hover .nav-icon { color: var(--ink); background: #fff; border-color: #ebe6de; }
.nav-item.active .nav-icon { color: var(--accent); background: var(--accent-soft); border-color: rgba(199,102,63,.12); }
.nav-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sidebar-spacer { flex: 1; }
.side-status { gap: 8px; margin: 12px 3px 14px; padding: 9px 8px; border: 1px solid #dedbd3; border-radius: 9px; background: rgba(255,255,255,.32); color: #8f8a81; font-size: 10px; }
.status-dot { width: 6px; height: 6px; flex: 0 0 auto; border-radius: 50%; background: #6eab80; box-shadow: 0 0 0 3px rgba(110,171,128,.13); }
.secondary-nav { padding-top: 13px; border-top: 1px solid #dfdcd4; }
.profile-chip { gap: 8px; margin-top: 12px; padding: 8px 6px; }
.profile-chip > div:nth-child(2) { min-width: 0; flex: 1; }
.profile-chip strong { display: block; overflow: hidden; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.avatar { display: grid; place-items: center; width: 28px; height: 28px; flex: 0 0 auto; border-radius: 8px; background: #d8a083; color: #fff; font-size: 11px; font-weight: 700; }
.avatar.small { width: 29px; height: 29px; border: 2px solid rgba(255,255,255,.85); box-shadow: 0 0 0 1px #dedbd3; }

.main-content { min-width: 0; flex: 1; height: 100vh; padding: 0 clamp(24px, 4vw, 64px) 15px; overflow: hidden; }
.topbar { display: flex; align-items: center; justify-content: space-between; height: 54px; }
.breadcrumb { gap: 8px; color: #aaa69e; font-size: 11px; }
.breadcrumb i { color: #cecbc3; font-style: normal; }
.breadcrumb strong { color: #5e5a53; font-weight: 600; }
.top-actions { gap: 12px; }
.icon-button { position: relative; display: grid; place-items: center; width: 30px; height: 30px; background: transparent; color: #807c74; border-radius: 8px; }
.icon-button:hover { background: var(--surface-strong); color: var(--ink); }
.notification-dot { position: absolute; top: 5px; right: 5px; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); border: 1px solid var(--bg); }

.hero-section { position: relative; min-height: 0; height: 40vh; max-height: 330px; --pointer-edge: 0; display: flex; align-items: flex-end; justify-content: space-between; overflow: hidden; padding: 30px 38px 27px; border: 1px solid #e5e1d9; border-radius: 18px; background: #f8f6f1; isolation: isolate; }
.hero-copy { position: relative; z-index: 2; max-width: 650px; }
.eyebrow, .section-kicker { margin: 0; color: var(--accent); font-size: 9px; font-weight: 700; letter-spacing: .16em; }
.eyebrow { display: flex; align-items: center; gap: 8px; }
.eyebrow-line { width: 20px; height: 1px; background: var(--accent); }
.hero-section h1 { max-width: 580px; margin: 12px 0 9px; font-family: Georgia, "Songti SC", serif; font-size: clamp(28px, 3.6vw, 46px); font-weight: 400; line-height: 1.08; letter-spacing: -.055em; }
.hero-section h1 em { color: var(--accent); font-style: normal; }
.hero-description { margin: 0 0 15px; color: #87837b; font-size: 12px; }
.ask-box { display: flex; align-items: center; max-width: 560px; min-height: 45px; padding: 4px 5px 4px 13px; border: 1px solid #dfd9cf; border-radius: 11px; background: rgba(255,255,255,.78); box-shadow: 0 8px 20px rgba(80,60,40,.04); transition: border-color .2s ease, box-shadow .2s ease; }
.ask-box.focused { border-color: rgba(199,102,63,.6); box-shadow: 0 10px 26px rgba(199,102,63,.11); }
.ask-icon { flex: 0 0 auto; color: #b4afa6; width: 17px; }
.ask-box input { min-width: 0; flex: 1; height: 35px; padding: 0 10px; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 11px; }
.ask-box input::placeholder { color: #aaa69e; }
.ask-submit { display: flex; align-items: center; gap: 9px; height: 35px; padding: 0 13px; border-radius: 8px; background: var(--ink); color: white; font-size: 11px; transition: background .18s ease, transform .18s ease; }
.ask-submit:hover { background: #46433d; transform: translateX(2px); }
.prompt-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 10px; color: #a39e94; font-size: 10px; }
.prompt-row button { padding: 0; border-bottom: 1px solid #d7b6a7; background: transparent; color: #9a5a43; font-size: 10px; }
.prompt-row button:hover { color: var(--ink); border-color: var(--ink); }
.hero-proof { position: relative; z-index: 2; gap: 8px; align-self: flex-start; margin: 2px 0 0 20px; padding: 9px 11px; border: 1px solid #e4ded5; border-radius: 10px; background: rgba(255,255,255,.62); box-shadow: 0 8px 20px rgba(80,60,40,.04); }
.proof-icon { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; background: #e5f1e9; color: #6eab80; }
.hero-proof strong, .hero-proof span { display: block; }
.hero-proof strong { font-size: 10px; }
.hero-proof span { margin-top: 3px; color: #9e998f; font-size: 9px; }
.hero-canvas, .hero-grid, .hero-glow, .hero-trail, .hero-orb { position: absolute; inset: 0; pointer-events: none; }
.hero-canvas { z-index: 0; width: 100%; height: 100%; opacity: .82; }
.hero-grid { z-index: 0; opacity: .36; background-image: linear-gradient(rgba(179,151,132,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(179,151,132,.12) 1px, transparent 1px); background-size: 23px 23px; mask-image: linear-gradient(90deg, transparent 14%, #000 64%); }
.hero-glow { z-index: 1; opacity: 0; background: radial-gradient(circle at var(--glow-x, 76%) var(--glow-y, 46%), rgba(255,235,214,.72), rgba(244,207,186,.18) 30%, transparent 62%); transition: opacity .35s ease; }
.hero-glow.visible { opacity: 1; }
.hero-trail { z-index: 1; opacity: 0; background: radial-gradient(ellipse 18% 28% at var(--glow-x, 76%) var(--glow-y, 46%), rgba(199,102,63,.16), transparent 72%); filter: blur(12px); transition: opacity .35s ease; }
.hero-trail.visible { opacity: 1; }
.hero-orb { z-index: 1; inset: auto; width: 235px; height: 185px; border-radius: var(--orb-radius, 48% 52% 56% 44% / 50% 42% 58% 50%); background: rgba(230,161,127,.2); transform: translate3d(var(--orb-x,0), var(--orb-y,0), 0) rotate(var(--orb-rotate,0deg)) scale(var(--orb-scale,1)); filter: blur(.2px); transition: border-radius .55s ease, transform .7s cubic-bezier(.2,.72,.2,1); }
.orb-one { right: 9%; top: 17%; }
.orb-two { right: 20%; top: 35%; width: 116px; height: 116px; background: rgba(245,217,198,.26); }

.section-block { position: relative; z-index: 2; margin-top: 17px; }
.section-heading { justify-content: space-between; margin-bottom: 8px; }
.section-heading h2 { margin: 3px 0 0; font-size: 15px; letter-spacing: -.03em; }
.text-button { display: inline-flex; align-items: center; gap: 5px; padding: 4px 0; background: transparent; color: #938d83; font-size: 10px; }
.text-button:hover { color: var(--accent); }
.service-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.service-card { position: relative; min-width: 0; min-height: 108px; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding: 12px; border: 1px solid var(--line); border-radius: 12px; background: rgba(255,255,255,.68); color: var(--ink); text-align: left; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
.service-card:hover { border-color: #d7b4a4; box-shadow: var(--shadow); transform: translateY(-2px); }
.service-icon { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; font-size: 14px; font-weight: 700; }
.service-icon.orange { background: #fae7de; color: #c8785a; }
.service-icon.blue { background: #e5eef4; color: #7094af; }
.service-icon.green { background: #e4f0e8; color: #6c9b7b; }
.service-icon.purple { background: #ece7f3; color: #8b77a5; }
.service-copy { min-width: 0; }
.service-copy span { display: block; margin: 8px 0 3px; color: #aaa59c; font-size: 9px; }
.service-copy strong { display: block; overflow: hidden; font-size: 11px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.service-copy p { margin: 4px 0 0; color: #a29d94; font-size: 9px; line-height: 1.35; }
.service-arrow { position: absolute; top: 12px; right: 12px; width: 13px; color: #c4bfb5; }

.recent-section { margin-top: 15px; }
.recent-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; border-top: 1px solid var(--line); }
.recent-row { width: 100%; min-width: 0; gap: 9px; min-height: 51px; padding: 8px 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); text-align: left; }
.recent-row:hover { color: var(--accent); }
.recent-line { width: 4px; height: 4px; flex: 0 0 auto; border-radius: 50%; background: var(--accent); }
.recent-row:nth-child(2) .recent-line { background: #779db1; }
.recent-content { min-width: 0; flex: 1; }
.recent-content strong, .recent-content small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-content strong { color: var(--ink); font-size: 11px; font-weight: 550; }
.recent-content small { margin-top: 4px; color: #aaa49a; font-size: 9px; }
.recent-content small i { margin: 0 4px; color: #c7c1b7; font-style: normal; }
.recent-row > svg { flex: 0 0 auto; width: 13px; color: #c4bfb7; }
.page-footer { display: flex; justify-content: space-between; gap: 20px; margin-top: 12px; padding-top: 9px; border-top: 1px solid var(--line); color: #aaa59d; font-size: 9px; }

@media (max-width: 1150px) {
  .main-content { padding-inline: 28px; }
  .hero-proof { display: none; }
}
@media (max-width: 860px) {
  .sidebar { width: 72px; flex-basis: 72px; padding-inline: 9px; }
  .brand-lockup { justify-content: center; padding-inline: 0; }
  .brand-lockup > div:last-child, .nav-label, .side-status, .profile-chip, .secondary-nav { display: none; }
  .nav-item { justify-content: center; gap: 0; padding: 0; }
  .main-content { padding-inline: 20px; }
  .hero-section { padding-inline: 25px; }
}
@media (max-width: 680px) {
  .app-shell { height: auto; min-height: 100vh; overflow: visible; }
  .sidebar { position: sticky; top: 0; z-index: 10; width: 62px; flex-basis: 62px; min-height: 100vh; }
  .main-content { height: auto; min-height: 100vh; padding-inline: 15px; overflow: visible; }
  .hero-section { height: auto; min-height: 330px; max-height: none; padding: 25px 18px 22px; border-radius: 15px; }
  .hero-section h1 { max-width: 300px; font-size: 34px; }
  .hero-description { max-width: 290px; line-height: 1.55; }
  .ask-box { align-items: stretch; flex-wrap: wrap; padding: 7px; }
  .ask-icon { margin: 10px 0 0 5px; }
  .ask-box input { flex-basis: calc(100% - 32px); height: 34px; }
  .ask-submit { width: 100%; justify-content: center; }
  .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .recent-list { grid-template-columns: 1fr; gap: 0; }
  .page-footer { flex-direction: column; gap: 5px; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-canvas { display: none; }
  .hero-orb, .hero-glow, .hero-trail, .service-card, .ask-submit, .nav-item { transition: none !important; }
}
