<script setup lang="ts">
import { onBeforeUnmount, onMounted, ref } from 'vue'
import { ArrowRight, Bell, ChatDotRound, CollectionTag, HomeFilled, MagicStick, QuestionFilled, Search, Setting, Clock, Check } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'
import { recentConversations, serviceItems } from '../data/home.mock'

const question = ref('')
const activeNav = ref('home')
const isFocused = ref(false)
const heroHover = ref(false)
const pointerState = ref<'idle' | 'active' | 'returning'>('idle')
const pointer = { x: 0, y: 0, targetX: 0, targetY: 0, velocityX: 0, velocityY: 0 }
const orbOneStyle = ref<Record<string, string>>({})
const orbTwoStyle = ref<Record<string, string>>({})
const glowStyle = ref<Record<string, string>>({})
const heroCanvas = ref<HTMLCanvasElement | null>(null)
let animationFrame = 0
let canvasFrame = 0
let canvasResizeObserver: ResizeObserver | null = null
let heroContext: CanvasRenderingContext2D | null = null
let canvasWidth = 0
let canvasHeight = 0
let canvasDpr = 1

function askQuestion(value = question.value) {
  const text = value.trim()
  if (!text) {
    ElMessage.warning('先输入一个想咨询的校园事务吧')
    return
  }
  ElMessage.success(`已准备咨询：“${text}”`)
}

function selectService(prompt: string) {
  question.value = prompt
  isFocused.value = true
}

function drawHeroField() {
  if (!heroContext || !canvasWidth || !canvasHeight) return
  const ctx = heroContext
  const x = canvasWidth * (0.76 + pointer.x * 0.12)
  const y = canvasHeight * (0.46 + pointer.y * 0.16)
  const speed = Math.min(1, Math.hypot(pointer.velocityX, pointer.velocityY) * 7)
  ctx.clearRect(0, 0, canvasWidth, canvasHeight)
  ctx.save()
  ctx.globalCompositeOperation = 'screen'
  const glow = ctx.createRadialGradient(x, y, 0, x, y, Math.max(canvasWidth, canvasHeight) * 0.44)
  glow.addColorStop(0, `rgba(255, 245, 226, ${0.28 + speed * 0.12})`)
  glow.addColorStop(0.32, 'rgba(236, 178, 145, 0.13)')
  glow.addColorStop(1, 'rgba(236, 178, 145, 0)')
  ctx.fillStyle = glow
  ctx.fillRect(0, 0, canvasWidth, canvasHeight)

  const ringRadius = 72 + speed * 22 + Math.sin(performance.now() / 620) * 3
  ctx.translate(x, y)
  ctx.rotate((pointer.velocityX - pointer.velocityY) * 0.45)
  ctx.scale(1 + pointer.x * 0.07, 1 + pointer.y * 0.06)
  ctx.strokeStyle = `rgba(193, 116, 82, ${0.10 + speed * 0.08})`
  ctx.lineWidth = 1
  ctx.beginPath()
  ctx.ellipse(0, 0, ringRadius, ringRadius * (0.68 + Math.abs(pointer.x) * 0.14), 0, 0, Math.PI * 2)
  ctx.stroke()
  ctx.restore()

  ctx.globalCompositeOperation = 'source-over'
  const gridSize = 22
  for (let gx = canvasWidth * 0.54; gx < canvasWidth; gx += gridSize) {
    for (let gy = 10; gy < canvasHeight; gy += gridSize) {
      const dx = gx - x
      const dy = gy - y
      const influence = Math.max(0, 1 - Math.hypot(dx, dy) / 220)
      if (influence <= 0) continue
      ctx.fillStyle = `rgba(181, 139, 115, ${0.06 + influence * 0.11})`
      ctx.fillRect(gx + pointer.velocityX * influence * 2, gy + pointer.velocityY * influence * 2, 1.5, 1.5)
    }
  }
}

function resizeHeroCanvas() {
  const canvas = heroCanvas.value
  if (!canvas) return
  const rect = canvas.getBoundingClientRect()
  canvasDpr = Math.min(window.devicePixelRatio || 1, 2)
  canvasWidth = rect.width
  canvasHeight = rect.height
  canvas.width = Math.round(canvasWidth * canvasDpr)
  canvas.height = Math.round(canvasHeight * canvasDpr)
  heroContext = canvas.getContext('2d')
  heroContext?.setTransform(canvasDpr, 0, 0, canvasDpr, 0, 0)
  drawHeroField()
}

function animatePointer() {
  const nextX = (pointer.targetX - pointer.x) * 0.11
  const nextY = (pointer.targetY - pointer.y) * 0.11
  pointer.velocityX = nextX - pointer.velocityX * 0.76
  pointer.velocityY = nextY - pointer.velocityY * 0.76
  pointer.x += nextX
  pointer.y += nextY
  drawHeroField()
  const distance = Math.min(1, Math.hypot(pointer.x, pointer.y) / 0.72)
  const angle = Math.atan2(pointer.y, pointer.x) * 180 / Math.PI
  orbOneStyle.value = {
    '--orb-x': `${pointer.x * 18}px`,
    '--orb-y': `${pointer.y * 15}px`,
    '--orb-rotate': `${angle * 0.08}deg`,
    '--orb-scale': `${1 + distance * 0.08}`,
    '--orb-radius': `${46 + pointer.x * 10}% ${54 - pointer.y * 9}% ${60 + pointer.y * 11}% ${40 - pointer.x * 8}% / ${45 + pointer.y * 9}% ${38 - pointer.x * 7}% ${62 + pointer.x * 8}% ${55 - pointer.y * 10}%`,
  }
  orbTwoStyle.value = {
    '--orb-x': `${pointer.x * -12}px`,
    '--orb-y': `${pointer.y * -10}px`,
    '--orb-rotate': `${-angle * 0.12}deg`,
    '--orb-scale': `${1 + distance * 0.12}`,
    '--orb-radius': `${54 - pointer.y * 9}% ${46 + pointer.y * 8}% ${41 - pointer.x * 9}% ${59 + pointer.x * 8}% / ${58 - pointer.x * 8}% ${44 + pointer.y * 8}% ${56 + pointer.x * 7}% ${42 - pointer.y * 8}%`,
  }
  glowStyle.value = { '--glow-x': `${50 + pointer.x * 34}%`, '--glow-y': `${50 + pointer.y * 32}%` }
  const settled = !heroHover.value && Math.abs(pointer.x) < 0.002 && Math.abs(pointer.y) < 0.002 && Math.abs(pointer.velocityX) < 0.002 && Math.abs(pointer.velocityY) < 0.002
  if (settled) {
    pointer.x = 0
    pointer.y = 0
    pointer.velocityX = 0
    pointer.velocityY = 0
    drawHeroField()
    animationFrame = 0
    return
  }
  animationFrame = requestAnimationFrame(animatePointer)
}

function runCanvasLoop() {
  if (!heroHover.value) {
    canvasFrame = 0
    drawHeroField()
    return
  }
  drawHeroField()
  canvasFrame = requestAnimationFrame(runCanvasLoop)
}

function startCanvasLoop() {
  if (!canvasFrame) canvasFrame = requestAnimationFrame(runCanvasLoop)
}

function handlePointerMove(event: PointerEvent) {
  const target = event.currentTarget as HTMLElement
  const rect = target.getBoundingClientRect()
  pointer.targetX = ((event.clientX - rect.left) / rect.width - 0.5) * 2
  pointer.targetY = ((event.clientY - rect.top) / rect.height - 0.5) * 2
  heroHover.value = true
  pointerState.value = 'active'
  startCanvasLoop()
  if (!animationFrame) animatePointer()
}

function resetPointer() {
  pointer.targetX = 0
  pointer.targetY = 0
  heroHover.value = false
  pointerState.value = 'returning'
}

onMounted(() => {
  resizeHeroCanvas()
  if (heroCanvas.value) {
    canvasResizeObserver = new ResizeObserver(resizeHeroCanvas)
    canvasResizeObserver.observe(heroCanvas.value)
  }
})

onBeforeUnmount(() => {
  if (animationFrame) cancelAnimationFrame(animationFrame)
  if (canvasFrame) cancelAnimationFrame(canvasFrame)
  canvasResizeObserver?.disconnect()
})
</script>

<template>
  <div class="app-shell">
    <aside class="sidebar" data-od-id="app-sidebar">
      <div class="brand-lockup" data-od-id="brand-lockup"><div class="brand-mark"><MagicStick :size="17" /></div><div><strong>小秘书</strong><span>校园办事助手</span></div></div>
      <nav class="primary-nav" aria-label="主导航">
        <button :class="['nav-item', { active: activeNav === 'home' }]" data-od-id="nav-home" @click="activeNav = 'home'"><HomeFilled :size="17" />首页</button>
        <button :class="['nav-item', { active: activeNav === 'chat' }]" data-od-id="nav-chat" @click="activeNav = 'chat'"><ChatDotRound :size="17" />我的对话</button>
        <button :class="['nav-item', { active: activeNav === 'services' }]" data-od-id="nav-services" @click="activeNav = 'services'"><CollectionTag :size="17" />支持事项</button>
        <button :class="['nav-item', { active: activeNav === 'history' }]" data-od-id="nav-history" @click="activeNav = 'history'"><Clock :size="17" />最近记录</button>
      </nav>
      <div class="sidebar-spacer"></div>
      <div class="side-status"><span class="status-dot"></span><span>知识库已更新</span></div>
      <nav class="secondary-nav" aria-label="辅助导航"><button class="nav-item" data-od-id="nav-help"><span class="nav-icon"><QuestionFilled /></span><span class="nav-label">使用帮助</span></button><button class="nav-item" data-od-id="nav-settings"><span class="nav-icon"><Setting /></span><span class="nav-label">设置</span></button></nav>
      <div class="profile-chip" data-od-id="profile-chip"><div class="avatar">林</div><div><strong>林同学</strong><span>本科生 · 一校区</span></div></div>
    </aside>

    <main class="main-content" data-od-id="home-main">
      <header class="topbar" data-od-id="global-header"><div class="breadcrumb"><span>工作台</span><i>/</i><strong>首页</strong></div><div class="top-actions"><button class="icon-button" aria-label="通知" data-od-id="notification-button"><Bell :size="18" /><span class="notification-dot"></span></button><button class="avatar small" aria-label="个人中心">林</button></div></header>

      <section :class="['hero-section', `pointer-${pointerState}`]" data-od-id="hero-section" @pointermove="handlePointerMove" @pointerleave="resetPointer">
        <canvas ref="heroCanvas" class="hero-canvas" aria-hidden="true"></canvas><div class="hero-glow" :class="{ visible: heroHover }" :style="glowStyle"></div><div class="hero-trail" :class="{ visible: heroHover }" :style="glowStyle"></div><div class="hero-orb orb-one" :style="orbOneStyle"></div><div class="hero-orb orb-two" :style="orbTwoStyle"></div><div class="hero-grid"></div>
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span>校园事务工作台</p>
          <h1 data-od-id="hero-title">今天，<em>先把一件事办好。</em></h1>
          <p class="hero-description">从可靠的校园知识中找到下一步，不用再翻找群聊和通知。</p>
          <div :class="['ask-box', { focused: isFocused }]" data-od-id="question-input-wrap"><Search :size="20" class="ask-icon" /><input v-model="question" type="text" placeholder="试试问：学生证丢了怎么补办？" data-od-id="question-input" @focus="isFocused = true" @keyup.enter="askQuestion()" /><button class="ask-submit" data-od-id="ask-submit" @click="askQuestion()">开始咨询<ArrowRight :size="16" /></button></div>
          <div class="prompt-row"><span>你也可以试试</span><button @click="selectService('校园卡丢失后应该怎么处理？')">校园卡丢失怎么办</button><button @click="selectService('宿舍水龙头坏了，应该在哪里报修？')">宿舍报修流程</button></div>
        </div>
        <div class="hero-proof"><div class="proof-icon"><Check :size="15" /></div><div><strong>回答有依据</strong><span>来源与更新时间会一起展示</span></div></div>
      </section>

      <section class="section-block services-section" data-od-id="quick-services"><div class="section-heading"><div><p class="section-kicker">QUICK ACCESS</p><h2>常用服务</h2></div><button class="text-button" data-od-id="view-all-services" @click="activeNav = 'services'">查看全部 <ArrowRight :size="15" /></button></div><div class="service-grid"><button v-for="service in serviceItems" :key="service.id" class="service-card" :data-od-id="`service-card-${service.id}`" @click="selectService(service.prompt)"><div :class="['service-icon', service.tone]">{{ service.icon }}</div><div class="service-copy"><span>{{ service.category }}</span><strong>{{ service.title }}</strong><p>{{ service.description }}</p></div><ArrowRight :size="16" class="service-arrow" /></button></div></section>

      <section class="section-block recent-section" data-od-id="recent-conversations"><div class="section-heading"><div><p class="section-kicker">RECENTLY ASKED</p><h2>最近咨询</h2></div><button class="text-button" data-od-id="view-all-history" @click="activeNav = 'history'">全部记录 <ArrowRight :size="15" /></button></div><div class="recent-list"><button v-for="item in recentConversations.slice(0, 2)" :key="item.id" class="recent-row" :data-od-id="item.id" @click="selectService(item.question)"><span class="recent-line"></span><span class="recent-content"><strong>{{ item.question }}</strong><small>{{ item.time }} <i>·</i> {{ item.tag }}</small></span><ArrowRight :size="15" /></button></div></section>
      <footer class="page-footer"><span>小秘书目前支持 4 项校园事务</span><span>本地演示 · 不收集敏感信息</span></footer>
    </main>
  </div>
</template>

