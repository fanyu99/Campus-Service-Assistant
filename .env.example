# 校园办事小秘书 · 后端配置样例
# 复制为 .env 后填写真实值；.env 不入库，本文件可入库作为配置参考

# 服务监听端口（缺省 8000）
APP_PORT=8000

# 运行环境：local / production
APP_ENV=local

# 数据库连接串（与 docker-compose db 段一致）
DATABASE_URL=mysql+pymysql://app:app@db:3306/campus

# 华为云 AgentArts（智果）智能体平台：问答工作流调用（配置后优先于直连 MaaS）
# api_key 与 agent_id 均填写才生效；base_url 以控制台该工作流「API 调用」页给出的值为准
AGENTARTS_API_KEY=
AGENTARTS_BASE_URL=
AGENTARTS_AGENT_ID=
AGENTARTS_CONNECT_TIMEOUT=2.0
AGENTARTS_READ_TIMEOUT=15.0
AGENTARTS_MAX_ATTEMPTS=2

# 华为云 MaaS（ModelArts Studio）模型服务——当前问答链路的生成能力来源
# base_url 可填控制台「调用说明」给出的完整地址（含 /chat/completions 亦可，客户端会自动识别）；
# 区域：西南-贵阳一
# model 缺省 deepseek-v4-flash：同账号可用的 11 个模型里（其余多数需单独开通），
# 它的延迟最稳——20 次连续调用中位 4.75 秒、p95 6.27 秒、全部 <8 秒；
# 同为推理系的 deepseek-v4.1-flash 虽能全部正常作答，但 p95 达 18.63 秒（5/20 超过 8 秒）。
MAAS_API_KEY=
MAAS_BASE_URL=https://api.modelarts-maas.com/v2
MAAS_MODEL=deepseek-v4-flash
# 关闭模型思考链（默认 true）。推理模型（如 deepseek-v4.1-flash）会先输出 reasoning_content：
# 实测同一问题耗时 12.8~65.5 秒且偶发 JSON 截断，关闭后约 2~5 秒且输出稳定，
# 这是满足「典型回答 8 秒以内」验收指标的关键开关。若换成非推理模型可设为 false。
MAAS_DISABLE_THINKING=true