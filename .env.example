# 校园办事小秘书 · 后端配置样例
# 复制为 .env 后填写真实值；.env 不入库，本文件可入库作为配置参考

# 服务监听端口（缺省 8000）
APP_PORT=8000

# 运行环境：local / production
APP_ENV=local

# 数据库连接串（与 docker-compose db 段一致）
DATABASE_URL=mysql+pymysql://app:app@db:3306/campus

# 华为云 AgentArts（智果）智能体平台：问答工作流调用（配置后优先于直连 MaaS）
# api_key 与 agent_id 均填写才生效；base_url 以控制台该工作流「API 调用」页给出的值为准
AGENTARTS_API_KEY=
AGENTARTS_BASE_URL=
AGENTARTS_AGENT_ID=
AGENTARTS_CONNECT_TIMEOUT=2.0
AGENTARTS_READ_TIMEOUT=15.0
AGENTARTS_MAX_ATTEMPTS=2

# 华为云 MaaS（ModelArts Studio）模型服务——当前问答链路的生成能力来源
# base_url / model 请以控制台该模型「调用说明」给出的值为准（区域：西南-贵阳一）
MAAS_API_KEY=
MAAS_BASE_URL=https://api.modelarts-maas.com/v2
MAAS_MODEL=DeepSeek-V3